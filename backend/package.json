{
  "name": "page-pulse-backend",
  "version": "1.0.0",
  "description": "Page Pulse — Lightweight web auditing API that analyzes public webpages and returns structured SEO and content metrics.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:unit": "jest src/tests/unit --verbose --runInBand --coverage"
  },
  "keywords": [
    "seo",
    "audit",
    "web",
    "page-pulse",
    "cheerio",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0"
  }
}
